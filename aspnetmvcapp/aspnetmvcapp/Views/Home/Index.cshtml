@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron">
    <h1>Frontend</h1>
    <p class="lead">This frontend application provides the web experience for the .NET Microservices sample environment.</p>
    <p><a href="@Url.Action("About", "Home")" class="btn btn-primary btn-lg">Learn more &raquo;</a></p>
</div>

<div class="row">
    <div class="col-md-4">
        <h2>Overview</h2>
        <p>
            Explore the MVC frontend that can be packaged into Docker images and deployed with the
            Helm chart included in this repository.
        </p>
        <p><a class="btn btn-default" href="@Url.Action("About", "Home")">About the app &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Deployment</h2>
        <p>Build the application into a container image and deploy it to Kubernetes with the repository's frontend Helm chart.</p>
        <p><a class="btn btn-default" href="https://github.com/netmicroservices/frontend/tree/main/aspnetmvcapp/frontendchart">View chart &raquo;</a></p>
    </div>
    <div class="col-md-4">
        <h2>Support</h2>
        <p>Need help or want to report a problem? Use the repository issue tracker to share details with the maintainers.</p>
        <p><a class="btn btn-default" href="https://github.com/netmicroservices/frontend/issues">Open issues &raquo;</a></p>
    </div>
</div>
